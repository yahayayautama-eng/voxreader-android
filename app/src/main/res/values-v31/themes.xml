<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ system splash screen. No androidx.core:core-splashscreen
         dependency needed — the app already has its own in-app Splash composable
         route that takes over immediately after this. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/brand_carbon</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowBackground">@color/brand_carbon</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
