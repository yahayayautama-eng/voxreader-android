    <string name="about_privacy_title">Privacy by default</string>
    <string name="about_privacy_body">Documents, camera OCR, reading progress, bookmarks, highlights, and listening history stay on this device. The optional Online voice sends only the text being spoken to Microsoft for synthesis.</string>
    <string name="about_backup_title">Your data</string>
    <string name="about_backup_body">Vox Reader has no account or cloud sync. Use Data and storage in Settings to export a validated local backup you control.</string>
    <string name="about_fonts_title">Fonts and open-source notices</string>
    <string name="about_fonts_body">Interface: Inter. Reader: Source Serif 4 and Newsreader. Utility: JetBrains Mono. These fonts are bundled under their respective SIL Open Font Licenses.</string>
    <string name="about_software_body">Vox Reader uses Android Jetpack, Kotlin, ML Kit text recognition, PDFBox Android, Bouncy Castle, OkHttp, and sherpa-onnx. Their notices and licences are distributed with their source packages and app distribution materials.</string>
