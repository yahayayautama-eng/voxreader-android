<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Compose (MyApplicationTheme) owns all real UI; this only controls the
         pre-Compose window background and system bars before content draws. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/brand_carbon</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
